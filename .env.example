# Port this proxy listens on (also the port npm/pnpm should point at).
PORT=4873

# Public URL of this proxy. Tarball links in metadata are rewritten to this.
SERVER_URL=http://localhost:4873

# Upstream npm registry to cache from.
NPM_UPSTREAM=https://registry.npmjs.com

# Upstream PyPI index and the host its package files live on. For a mirror
# (e.g. Nexus) set both to the repository URL; relative file links are resolved.
PYPI_UPSTREAM=https://pypi.org

# Optional dedicated domains. When set, that registry is served only on its
# domain, at the root (npm: http://npm.example.com, pip: http://pypi.example.com,
# files at /files), and its *_PATH above is ignored. Leave empty to use paths.
NPM_DOMAIN=
PYTHON_DOMAIN=

# Directory for cached metadata and tarballs.
STORAGE=./storage
# Route prefixes clients use: http://host:PORT/npm and http://host:PORT/pypi
NPM_PATH=/npm
PYTHON_PATH=/pypi

# Serve cached metadata without revalidating upstream (fastest, may go stale).
# Set to "true" or "1" to enable.
SKIP_304_CHECK=false

# Optional SOCKS5 proxy for the upstream connection. Leave SOCKS_HOST unset to
# connect directly. Handy for tunnelling around restrictive firewalls.
SOCKS_HOST=127.0.0.1
SOCKS_PORT=10808

# Keepalive PING interval (ms) for the upstream HTTP/2 session. A session that
# misses a PING is replaced, so silently dropped connections don't hang. 0 = off.
PING_INTERVAL_MS=30000


